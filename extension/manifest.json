{
  "manifest_version": 3,
  "name": "Compact Mode",
  "version": "0.2.1",
  "description": "Frameless mode for Firefox: hide the toolbars until you hover the top of the window. With the Argon theme, also picks Helium-style layouts (Classic, Dynamic, Compact, Vertical).",
  "browser_specific_settings": {
    "gecko": {
      "id": "compact-mode@rs4t",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Compact Mode",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "toggle-compact-mode": {
      "suggested_key": { "default": "Ctrl+Alt+C" },
      "description": "Turn compact mode on or off"
    }
  }
}
